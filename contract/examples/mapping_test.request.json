{
  "site": "lumen-shop.example",
  "mappings": [
    {
      "schema_version": 1,
      "template_id": "product",
      "label": "Lamp product page",
      "match": {
        "url_patterns": [
          "/produkt/[^/?]+$"
        ],
        "selector": "div.product-detail"
      },
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "multiple": false,
          "sources": [
            {
              "kind": "jsonld",
              "schema_type": "Product",
              "path": "name",
              "transforms": [
                {
                  "op": "trim"
                }
              ]
            },
            {
              "kind": "css",
              "selector": "h1.product-title",
              "extract": "text",
              "transforms": [
                {
                  "op": "trim"
                }
              ]
            }
          ]
        },
        {
          "name": "description",
          "type": "html",
          "required": false,
          "multiple": false,
          "sources": [
            {
              "kind": "css",
              "selector": "div.product-description",
              "extract": "html",
              "transforms": [
                {
                  "op": "html_clean"
                }
              ]
            }
          ]
        },
        {
          "name": "price",
          "type": "price",
          "required": true,
          "multiple": false,
          "sources": [
            {
              "kind": "jsonld",
              "schema_type": "Product",
              "path": "offers.price",
              "transforms": [
                {
                  "op": "price",
                  "decimal_separator": "dot"
                }
              ]
            },
            {
              "kind": "css",
              "selector": "span.price-current",
              "extract": "text",
              "transforms": [
                {
                  "op": "price",
                  "decimal_separator": "comma"
                }
              ]
            }
          ]
        },
        {
          "name": "currency",
          "type": "currency",
          "required": true,
          "multiple": false,
          "sources": [
            {
              "kind": "jsonld",
              "schema_type": "Product",
              "path": "offers.priceCurrency",
              "transforms": [
                {
                  "op": "currency"
                }
              ]
            },
            {
              "kind": "meta",
              "name": "product:price:currency",
              "transforms": [
                {
                  "op": "currency"
                }
              ]
            }
          ]
        },
        {
          "name": "part_number",
          "type": "text",
          "required": false,
          "multiple": false,
          "sources": [
            {
              "kind": "jsonld",
              "schema_type": "Product",
              "path": "sku",
              "transforms": [
                {
                  "op": "trim"
                }
              ]
            },
            {
              "kind": "css",
              "selector": "span.sku",
              "extract": "text",
              "transforms": [
                {
                  "op": "regex_extract",
                  "pattern": "Art\\.-Nr\\.\\s*([A-Z0-9-]+)",
                  "group": 1
                }
              ]
            }
          ]
        },
        {
          "name": "image_urls",
          "type": "image_url",
          "required": false,
          "multiple": true,
          "sources": [
            {
              "kind": "jsonld",
              "schema_type": "Product",
              "path": "image.*",
              "transforms": [
                {
                  "op": "absolute_url"
                }
              ]
            },
            {
              "kind": "css",
              "selector": "div.gallery img",
              "extract": "attribute",
              "attribute": "data-src",
              "transforms": [
                {
                  "op": "absolute_url"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "schema_version": 1,
      "template_id": "spare_part",
      "label": "Spare part sheet",
      "match": {
        "url_patterns": [
          "/ersatzteile/[^/?]+$"
        ],
        "selector": "section.part-sheet"
      },
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "sources": [
            {
              "kind": "css",
              "selector": "section.part-sheet h2",
              "extract": "text",
              "transforms": [
                {
                  "op": "trim"
                }
              ]
            }
          ]
        },
        {
          "name": "description",
          "type": "html",
          "sources": [
            {
              "kind": "css",
              "selector": "section.part-sheet .details",
              "extract": "html"
            }
          ]
        },
        {
          "name": "price",
          "type": "price",
          "required": true,
          "sources": [
            {
              "kind": "css",
              "selector": ".part-price .amount",
              "extract": "text",
              "transforms": [
                {
                  "op": "price",
                  "decimal_separator": "comma"
                }
              ]
            }
          ]
        },
        {
          "name": "currency",
          "type": "currency",
          "required": true,
          "sources": [
            {
              "kind": "css",
              "selector": ".part-price",
              "extract": "attribute",
              "attribute": "data-currency",
              "transforms": [
                {
                  "op": "currency"
                }
              ]
            },
            {
              "kind": "css",
              "selector": ".part-price .amount",
              "extract": "text",
              "transforms": [
                {
                  "op": "currency",
                  "default_currency": "EUR"
                }
              ]
            }
          ]
        },
        {
          "name": "part_number",
          "type": "text",
          "sources": [
            {
              "kind": "css",
              "selector": "dd.part-no",
              "extract": "text",
              "transforms": [
                {
                  "op": "trim"
                }
              ]
            }
          ]
        },
        {
          "name": "image_urls",
          "type": "image_url",
          "multiple": true,
          "sources": [
            {
              "kind": "css",
              "selector": "section.part-sheet img",
              "extract": "attribute",
              "attribute": "src",
              "transforms": [
                {
                  "op": "absolute_url"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "sample_ids": [
    "smp_01JCX9Q1A2B3C4D5E6F7G8H9J0",
    "smp_01JCX9Q4K5L6M7N8P9Q0R1S2T3"
  ],
  "required_fill_threshold": 0.9,
  "required_fields": [
    "title",
    "price",
    "currency"
  ],
  "require_all_samples_matched": true,
  "extraction_mode": "auto"
}
