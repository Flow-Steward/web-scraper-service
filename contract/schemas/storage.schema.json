{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.flowsteward.org/web-scraper/v1/storage.schema.json",
  "title": "Storage",
  "description": "Response of `GET /v1/admin/storage` (README 16). Sizes are apparent file sizes in bytes. Added 2026-11-14.",
  "type": "object",
  "required": [
    "time",
    "data_dir",
    "volume",
    "total_bytes",
    "kinds",
    "runs",
    "retention",
    "last_cleanup"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "run_summary.schema.json#/$defs/timestamp"
    },
    "data_dir": {
      "type": "string",
      "maxLength": 4096
    },
    "volume": {
      "type": "object",
      "description": "`shutil.disk_usage` of the data directory's file system.",
      "required": [
        "total_bytes",
        "free_bytes",
        "used_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of every kind's `bytes`."
    },
    "kinds": {
      "type": "object",
      "required": [
        "run_working_files",
        "result_files",
        "samples",
        "protection_screenshots",
        "database",
        "identities",
        "other"
      ],
      "additionalProperties": false,
      "properties": {
        "run_working_files": {
          "type": "object",
          "description": "`jobs/<run_id>`: Crawlee storage and stored pages; one item per run.",
          "required": [
            "bytes",
            "items",
            "oldest_at",
            "active_items",
            "orphan_items"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "oldest_at": {
              "anyOf": [
                {
                  "$ref": "run_summary.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Oldest modification time; null when empty."
            },
            "active_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Directories of runs that are not finished."
            },
            "orphan_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Directories without a run record."
            }
          }
        },
        "result_files": {
          "type": "object",
          "description": "`results/*.jsonl`.",
          "required": [
            "bytes",
            "items",
            "oldest_at",
            "unfetched_items",
            "unfetched_bytes",
            "active_items",
            "orphan_items"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "oldest_at": {
              "anyOf": [
                {
                  "$ref": "run_summary.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Oldest modification time; null when empty."
            },
            "unfetched_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Files of completed runs the platform has not fetched yet."
            },
            "unfetched_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "active_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Files being written by runs that are not finished."
            },
            "orphan_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Files without a run record."
            }
          }
        },
        "samples": {
          "type": "object",
          "description": "`samples/*.html` and `*.extra.json`; one item per sample.",
          "required": [
            "bytes",
            "items",
            "oldest_at",
            "orphan_items"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "oldest_at": {
              "anyOf": [
                {
                  "$ref": "run_summary.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Oldest modification time; null when empty."
            },
            "orphan_items": {
              "type": "integer",
              "minimum": 0,
              "description": "Samples with files but without a row."
            }
          }
        },
        "protection_screenshots": {
          "type": "object",
          "description": "`samples/shots/*.png`.",
          "required": [
            "bytes",
            "items",
            "oldest_at"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "oldest_at": {
              "anyOf": [
                {
                  "$ref": "run_summary.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Oldest modification time; null when empty."
            }
          }
        },
        "database": {
          "type": "object",
          "description": "`service.sqlite3` and its `-wal` / `-shm` files.",
          "required": [
            "bytes",
            "main_bytes",
            "wal_bytes",
            "shm_bytes",
            "reclaimable_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "main + WAL + SHM."
            },
            "main_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "wal_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "shm_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "reclaimable_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Free pages inside the main file; VACUUM gives them back."
            }
          }
        },
        "identities": {
          "type": "object",
          "description": "`identities.json` (browser identities per host). Never removed.",
          "required": [
            "bytes",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "other": {
          "type": "object",
          "description": "Anything else at the top of the data directory. Never removed.",
          "required": [
            "bytes",
            "items",
            "oldest_at"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "oldest_at": {
              "anyOf": [
                {
                  "$ref": "run_summary.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Oldest modification time; null when empty."
            }
          }
        }
      }
    },
    "runs": {
      "type": "object",
      "required": [
        "by_state",
        "total",
        "active",
        "oldest_finished_at"
      ],
      "additionalProperties": false,
      "properties": {
        "by_state": {
          "type": "object",
          "required": [
            "queued",
            "running",
            "waiting_for_credentials",
            "stopping",
            "completed",
            "failed"
          ],
          "additionalProperties": false,
          "properties": {
            "queued": {
              "type": "integer",
              "minimum": 0
            },
            "running": {
              "type": "integer",
              "minimum": 0
            },
            "waiting_for_credentials": {
              "type": "integer",
              "minimum": 0
            },
            "stopping": {
              "type": "integer",
              "minimum": 0
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "description": "Runs not finished, plus finished runs whose runner is still closing."
        },
        "oldest_finished_at": {
          "anyOf": [
            {
              "$ref": "run_summary.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "description": "The automatic sweeper's settings (`WSS_RETENTION_*`).",
      "required": [
        "result_days",
        "job_record_days",
        "stored_pages_days",
        "samples_hours",
        "interval_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "result_days": {
          "type": "integer",
          "minimum": 1
        },
        "job_record_days": {
          "type": "integer",
          "minimum": 1
        },
        "stored_pages_days": {
          "type": "integer",
          "minimum": 1
        },
        "samples_hours": {
          "type": "integer",
          "minimum": 1
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "How often the automatic sweeper runs."
        }
      }
    },
    "last_cleanup": {
      "type": "object",
      "description": "Kept in the database; survive a restart.",
      "required": [
        "automatic",
        "automatic_with_removals",
        "manual"
      ],
      "additionalProperties": false,
      "properties": {
        "automatic": {
          "anyOf": [
            {
              "$ref": "cleanup.schema.json#/$defs/cleanup_summary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sweeper's last pass (every `interval_seconds`, also when it removed nothing)."
        },
        "automatic_with_removals": {
          "anyOf": [
            {
              "$ref": "cleanup.schema.json#/$defs/cleanup_summary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sweeper's last pass that removed something."
        },
        "manual": {
          "anyOf": [
            {
              "$ref": "cleanup.schema.json#/$defs/cleanup_summary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The last applied `POST /v1/admin/cleanup`."
        }
      }
    }
  }
}
