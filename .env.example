# Settings of the Flow Steward Web Scraper service (docker-compose.yml reads this file as .env).
# Copy it to .env next to docker-compose.yml and fill the two required values.

# --- Required --------------------------------------------------------------------------

# Bearer token of the service API; you type it into the Flow Steward scraper profile.
# Generate: openssl rand -hex 32
WSS_API_TOKEN=

# Key that encrypts job secrets at rest. Keep a copy outside the server (a password
# manager): a lost or changed key makes stored job secrets unreadable.
# Generate: openssl rand -hex 32
WSS_SECRETS_KEY=

# --- Network ---------------------------------------------------------------------------

# Docker network of the Flow Steward Compact installation the service joins, so Flow Steward
# reaches it at http://web-scraper:8080. It is "<compose project>_default"; a standard
# install uses the project "flow-steward" (FS_COMPOSE_PROJECT_NAME in the installation's
# .flow-steward/compose.env). List the networks with: docker network ls
FS_DOCKER_NETWORK=flow-steward_default

# --- Optional (defaults shown) ---------------------------------------------------------

# Allow the one-time checkbox click on protected sites (route step "click").
# WSS_ALLOW_CHALLENGE_CLICK=0
# Allow paid challenge solvers (route step "solver").
# WSS_ALLOW_SOLVERS=0
# Allow runs with respect_robots: false.
# WSS_ALLOW_ROBOTS_OVERRIDE=0
# Runs at the same time (each browser run needs about 2 GB of memory).
# WSS_LIMIT_MAX_CONCURRENT_JOBS=2
# Retention: result files, run records, stored pages (days) and samples (hours).
# WSS_RETENTION_RESULT_DAYS=14
# WSS_RETENTION_JOB_RECORD_DAYS=30
# WSS_RETENTION_STORED_PAGES_DAYS=7
# WSS_RETENTION_SAMPLES_HOURS=24
# Log level.
# WSS_LOG_LEVEL=INFO
# Every other setting: README, "Configuration".
